<?xml version="1.0" encoding="utf-8"?>
<!-- A miniature of the app's log bar: tap the field to type, the mic to speak.
     Only RemoteViews-safe views (LinearLayout, TextView, ImageView) here. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <TextView
        android:id="@+id/log_widget_type"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_weight="1"
        android:background="@drawable/log_widget_field"
        android:gravity="center_vertical"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:text="@string/log_widget_hint"
        android:textColor="@color/widget_hint"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/log_widget_mic"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:padding="10dp"
        android:background="@drawable/log_widget_background"
        android:src="@drawable/ic_mic"
        android:contentDescription="@string/log_widget_mic" />
</LinearLayout>
